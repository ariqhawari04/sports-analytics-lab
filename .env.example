# Read-only PostgreSQL connection
# Used by the Streamlit application
SUPABASE_POOLER_HOST=
SUPABASE_READER_USER=
SUPABASE_READER_PASSWORD=

# Supabase API
# Used only for local data ingestion
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Football-data.org API
# Used for current-season data updates
FOOTBALL_DATA_TOKEN=
